; Browser tests. Once: npm install (in this directory), which fetches
; Playwright and its Chromium. Then: dune build @runbrowser
;
; The pages' results are compared with browser.expected, as a cram test's
; output is: a change shows as a diff, and dune promote accepts it. So a
; test can record a bug as it is, and the fix change [FAIL] to [PASS].
; The results are written by a shell, where dune does not see them as a
; target: a target would be built by dune build too, running the pages.

(rule
 (alias runbrowser)
 (deps
  %{project_root}/x-ocaml.js
  %{project_root}/x-ocaml.worker.js
  (source_tree .))
 (action
  (progn
   (system "node run_tests.js --transcript > browser.results")
   (diff? browser.expected browser.results))))
